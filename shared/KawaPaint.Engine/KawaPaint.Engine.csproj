<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The apps run on the SkiaSharp that Avalonia.Skia asks for (3.119.4 with Avalonia 12.1.1);
         this lower bound only matters when the engine is built on its own. Raising it to 3.119.4
         made the published web build fail at startup (libSkiaSharp not found), which the browser
         smoke test caught: do not raise it without that test passing. -->
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.156.0" />
  </ItemGroup>

</Project>
