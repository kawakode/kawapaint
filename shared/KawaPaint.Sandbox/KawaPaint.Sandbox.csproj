<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KawaPaint.Engine\KawaPaint.Engine.csproj" />
    <ProjectReference Include="..\KawaPaint.App\KawaPaint.App.csproj" />
    <ProjectReference Include="..\KawaPaint.Cli\KawaPaint.Cli.csproj" />
    <!-- ReferenceOutputAssembly=false: forces build order (the sample/fixture plugin DLLs must
         exist on disk before the plugin smoke test runs) without linking Sandbox against plugin
         code directly - the point is exercising the real ALC-based PluginManager.LoadFrom loader,
         not calling the plugin's types in-process. -->
    <ProjectReference Include="..\..\plugins\KawaPaint.Plugins.Sample\KawaPaint.Plugins.Sample.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\KawaPaint.Plugins.ThrowingFixture\KawaPaint.Plugins.ThrowingFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
