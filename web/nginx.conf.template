server {
    listen 80;
    server_name _;
    index index.html;

    # Keep nginx's complete MIME table. A server-level `types` block replaces the
    # inherited table, which made every file except .wasm (including index.html)
    # fall back to application/octet-stream and caused browsers to download it.
    # Current nginx images already map .wasm to application/wasm.
    include /etc/nginx/mime.types;

    gzip on;
    gzip_types application/wasm application/octet-stream application/javascript text/javascript text/css text/html application/json;
    gzip_min_length 1024;

@@BASE_PATH_REDIRECT@@

    # `alias` removes the configured URL prefix before looking up static files.
    # _framework/* filenames are content-hashed by the build, so they're safe to cache forever.
    location ^~ @@BASE_PATH_SLASH@@_framework/ {
        alias /usr/share/nginx/html/_framework/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location @@BASE_PATH_SLASH@@ {
        alias /usr/share/nginx/html/;
        add_header Cache-Control "no-cache";
    }
}
