<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\shared\KawaPaint.App\Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\KawaPaint.App\KawaPaint.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JPEG XL (jxl.dll + jxl_cms + brotli) and JPEG 2000 (openjp2.dll + its MSVC runtime deps),
         win-x64 only, so JxlCodec/Jp2Codec's IsAvailable is true without a system install.
         See TODO.md's JXL/JP2 packaging entry for provenance/versions and how this set was
         verified minimal. -->
    <None Include="natives\win-x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
