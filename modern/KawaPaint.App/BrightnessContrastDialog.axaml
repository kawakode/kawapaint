<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KawaPaint.App.BrightnessContrastDialog"
        Width="360" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Brightness / Contrast">
    <StackPanel Margin="16" Spacing="8">
        <Grid ColumnDefinitions="90,*,44">
            <TextBlock Grid.Column="0" Text="Brightness" VerticalAlignment="Center" />
            <Slider Grid.Column="1" x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0"
                    ValueChanged="OnChanged" />
            <TextBlock Grid.Column="2" x:Name="BrightnessLabel" Text="0" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>
        <Grid ColumnDefinitions="90,*,44">
            <TextBlock Grid.Column="0" Text="Contrast" VerticalAlignment="Center" />
            <Slider Grid.Column="1" x:Name="ContrastSlider" Minimum="50" Maximum="200" Value="100"
                    ValueChanged="OnChanged" />
            <TextBlock Grid.Column="2" x:Name="ContrastLabel" Text="1.00" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Reset" Click="OnReset" />
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="OK" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
