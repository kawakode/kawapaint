<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KawaPaint.App"
        x:Class="KawaPaint.App.MainWindow"
        Width="1100" Height="720"
        Title="KawaPaint">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="OnNew" />
                <MenuItem Header="_Open…" Click="OnOpen" />
                <MenuItem Header="Save _As…" Click="OnSaveAs" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="OnUndo" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" Click="OnRedo" InputGesture="Ctrl+Y" />
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Background="#282828" Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Pencil" Tag="Pencil" Click="OnTool" />
                <Button Content="Eraser" Tag="Eraser" Click="OnTool" />
                <Button Content="Fill" Tag="Fill" Click="OnTool" />
                <Button Content="Pick" Tag="Pick" Click="OnTool" />
                <Button Content="Line" Tag="Line" Click="OnTool" />
                <Button Content="Rect" Tag="Rect" Click="OnTool" />
                <Button Content="Ellipse" Tag="Ellipse" Click="OnTool" />
                <Border Width="1" Background="#505050" Margin="6,2" />
                <TextBlock Text="Color:" Foreground="#C0C0C0" VerticalAlignment="Center" />
                <Button Tag="#000000" Click="OnColor" Background="Black" Width="22" Height="22" />
                <Button Tag="#FFFFFF" Click="OnColor" Background="White" Width="22" Height="22" />
                <Button Tag="#E01010" Click="OnColor" Background="#E01010" Width="22" Height="22" />
                <Button Tag="#20B020" Click="OnColor" Background="#20B020" Width="22" Height="22" />
                <Button Tag="#2050E0" Click="OnColor" Background="#2050E0" Width="22" Height="22" />
                <Border Width="1" Background="#505050" Margin="6,2" />
                <TextBlock Text="Size:" Foreground="#C0C0C0" VerticalAlignment="Center" />
                <Slider x:Name="SizeSlider" Minimum="1" Maximum="64" Value="3" Width="140"
                        VerticalAlignment="Center" ValueChanged="OnSize" />
                <TextBlock x:Name="SizeLabel" Text="3 px" Foreground="#C0C0C0"
                           VerticalAlignment="Center" Width="42" />
                <Border Width="18" Height="18" x:Name="ColorSwatch" Background="Black"
                        BorderBrush="#808080" BorderThickness="1" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#202020" Padding="8,3">
            <TextBlock x:Name="StatusText" Foreground="#C0C0C0" Text="Ready" />
        </Border>

        <!-- Layers panel -->
        <Border DockPanel.Dock="Right" Width="220" Background="#262626" BorderBrush="#404040" BorderThickness="1,0,0,0">
            <DockPanel Margin="6">
                <TextBlock DockPanel.Dock="Top" Text="Layers" Foreground="#E0E0E0"
                           FontWeight="Bold" Margin="2,2,2,6" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                    <Button Content="Add" Click="OnAddLayer" />
                    <Button Content="Delete" Click="OnDeleteLayer" />
                    <Button Content="Up" Click="OnLayerUp" />
                    <Button Content="Down" Click="OnLayerDown" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="Blend mode" Foreground="#A0A0A0" Margin="2,0" />
                    <ComboBox x:Name="BlendCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="OnBlendChanged" />
                    <TextBlock Text="Opacity" Foreground="#A0A0A0" Margin="2,6,2,0" />
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="255" Value="255"
                            ValueChanged="OnOpacityChanged" />
                </StackPanel>
                <ListBox x:Name="LayerList" Background="#1E1E1E"
                         SelectionChanged="OnLayerSelected" />
            </DockPanel>
        </Border>

        <app:SurfaceView x:Name="Canvas" />
    </DockPanel>
</Window>
