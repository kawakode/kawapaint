<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:KawaPaint.App"
        x:Class="KawaPaint.App.MainView">
    <UserControl.Styles>
        <!-- Every panel background here is hardcoded dark regardless of the OS theme, but Button/
             ToggleButton text otherwise falls back to Fluent's theme-default foreground, which
             follows the OS setting — on a light system theme that's dark text on a dark panel.
             Force it light so button labels stay legible no matter the system theme. -->
        <Style Selector="Button, ToggleButton, MenuItem">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- CheckBox's Fluent template sets its label's Foreground directly on the inner
             ContentPresenter rather than passing the control's own Foreground through, so a plain
             "CheckBox" selector setter never reaches it — the template part has to be targeted. -->
        <Style Selector="CheckBox /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Same story for MenuItem's header text: the Fluent template binds it to the
             MenuFlyoutItemForeground theme resource rather than the control's own Foreground, and
             that resource resolves inconsistently once an Icon is set on some (but not all) items
             in this popup-heavy menu bar — some items render with washed-out, low-contrast text.
             Pin the header text part directly so every item is legible regardless. This only
             targets dropdown/submenu items (their popups render on a light background); the
             top-level bar items below are handled separately since they sit on the dark bar. -->
        <Style Selector="MenuItem MenuItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
        <!-- Top-level bar items (File/Edit/Select/…) always sit on the hardcoded dark bar
             background, so unlike their dropdown contents they need light text, not dark. -->
        <Style Selector="MenuItem.topbar /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Color swatches. The Fluent button template repaints its content background on
             hover/press, which would hide the very color the button exists to show, so the
             templated background is re-asserted in those states. -->
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
        </Style>
        <Style Selector="Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}" />
        </Style>
    </UserControl.Styles>
    <Panel>
    <DockPanel x:Name="RootDock">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Background="#282828">
        <Menu Grid.Column="0">
            <MenuItem Header="_File" Classes="topbar">
                <MenuItem Header="_New" Click="OnNew" InputGesture="Ctrl+N" Icon="{app:Icon New}" />
                <MenuItem Header="_Open Image…" Click="OnOpen" InputGesture="Ctrl+O" Icon="{app:Icon Open}" />
                <MenuItem Header="Open _Project…" Click="OnOpenProject" InputGesture="Ctrl+Shift+O" Icon="{app:Icon OpenProject}" />
                <MenuItem x:Name="RecentFilesMenu" Header="_Recent Files">
                    <MenuItem Header="(none yet)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Save _Project…" Click="OnSaveProject" InputGesture="Ctrl+S" Icon="{app:Icon Save}" />
                <MenuItem Header="_Export Flattened…" Click="OnSaveAs" InputGesture="Ctrl+Shift+S" Icon="{app:Icon Export}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" Icon="{app:Icon Exit}" />
            </MenuItem>
            <MenuItem Header="_Edit" Classes="topbar">
                <MenuItem Header="_Undo" Click="OnUndo" InputGesture="Ctrl+Z" Icon="{app:Icon Undo}" />
                <MenuItem Header="_Redo" Click="OnRedo" InputGesture="Ctrl+Y" Icon="{app:Icon Redo}" />
                <Separator />
                <MenuItem Header="Cu_t" Click="OnCut" InputGesture="Ctrl+X" Icon="{app:Icon Cut}" />
                <MenuItem Header="_Copy" Click="OnCopy" InputGesture="Ctrl+C" Icon="{app:Icon Copy}" />
                <MenuItem Header="Copy _Merged" Click="OnCopyMerged" InputGesture="Ctrl+Shift+C" />
                <MenuItem Header="_Paste" Click="OnPaste" InputGesture="Ctrl+V" Icon="{app:Icon Paste}" />
                <MenuItem Header="Paste Into _New Layer" Click="OnPasteIntoNewLayer" InputGesture="Ctrl+Shift+V" />
                <MenuItem Header="Paste Into New _Image" Click="OnPasteIntoNewImage" InputGesture="Ctrl+Alt+V" />
            </MenuItem>
            <MenuItem Header="_Select" Classes="topbar">
                <MenuItem Header="Select _All" Click="OnSelectAll" InputGesture="Ctrl+A" Icon="{app:Icon SelectAll}" />
                <MenuItem Header="_Invert" Click="OnInvertSelection" InputGesture="Ctrl+I" Icon="{app:Icon InvertSel}" />
                <MenuItem Header="Deselect (Select _None)" Click="OnSelectNone" InputGesture="Ctrl+D" Icon="{app:Icon Deselect}" />
                <Separator />
                <MenuItem Header="_Fill Selection" Click="OnFillSelection" InputGesture="Ctrl+F" Icon="{app:Icon Fill}" />
                <MenuItem Header="_Erase Selection" Click="OnEraseSelection" InputGesture="Delete" Icon="{app:Icon Trash}" />
            </MenuItem>
            <MenuItem Header="_View" Classes="topbar">
                <!-- These are spelled into the header rather than set as an InputGesture: a
                     KeyGesture for +/-/0/1 stringifies as "OemPlus"/"D0" in the menu. -->
                <MenuItem Header="Zoom _In   (Ctrl +)" Click="OnZoomIn" Icon="{app:Icon ZoomIn}" />
                <MenuItem Header="Zoom _Out   (Ctrl -)" Click="OnZoomOut" Icon="{app:Icon ZoomOut}" />
                <MenuItem Header="_Fit to Window   (Ctrl 0)" Click="OnZoomFit" Icon="{app:Icon ZoomFit}" />
                <MenuItem Header="_Actual Size 100%   (Ctrl 1)" Click="OnZoomActual" Icon="{app:Icon ZoomActual}" />
                <Separator />
                <MenuItem Header="_Panels">
                    <MenuItem Header="Tools">
                        <MenuItem Header="Left" Tag="Tools:Left" Click="OnPanelPlace" />
                        <MenuItem Header="Right" Tag="Tools:Right" Click="OnPanelPlace" />
                        <MenuItem Header="Top" Tag="Tools:Top" Click="OnPanelPlace" />
                        <MenuItem Header="Bottom" Tag="Tools:Bottom" Click="OnPanelPlace" />
                        <MenuItem Header="Floating" Tag="Tools:Floating" Click="OnPanelPlace" />
                        <MenuItem Header="Hidden" Tag="Tools:Hidden" Click="OnPanelPlace" />
                    </MenuItem>
                    <MenuItem Header="Colors">
                        <MenuItem Header="Left" Tag="Colors:Left" Click="OnPanelPlace" />
                        <MenuItem Header="Right" Tag="Colors:Right" Click="OnPanelPlace" />
                        <MenuItem Header="Top" Tag="Colors:Top" Click="OnPanelPlace" />
                        <MenuItem Header="Bottom" Tag="Colors:Bottom" Click="OnPanelPlace" />
                        <MenuItem Header="Floating" Tag="Colors:Floating" Click="OnPanelPlace" />
                        <MenuItem Header="Hidden" Tag="Colors:Hidden" Click="OnPanelPlace" />
                    </MenuItem>
                    <MenuItem Header="Color Wheel">
                        <MenuItem Header="Left" Tag="ColorWheel:Left" Click="OnPanelPlace" />
                        <MenuItem Header="Right" Tag="ColorWheel:Right" Click="OnPanelPlace" />
                        <MenuItem Header="Top" Tag="ColorWheel:Top" Click="OnPanelPlace" />
                        <MenuItem Header="Bottom" Tag="ColorWheel:Bottom" Click="OnPanelPlace" />
                        <MenuItem Header="Floating" Tag="ColorWheel:Floating" Click="OnPanelPlace" />
                        <MenuItem Header="Hidden" Tag="ColorWheel:Hidden" Click="OnPanelPlace" />
                    </MenuItem>
                    <MenuItem Header="Layers">
                        <MenuItem Header="Left" Tag="Layers:Left" Click="OnPanelPlace" />
                        <MenuItem Header="Right" Tag="Layers:Right" Click="OnPanelPlace" />
                        <MenuItem Header="Top" Tag="Layers:Top" Click="OnPanelPlace" />
                        <MenuItem Header="Bottom" Tag="Layers:Bottom" Click="OnPanelPlace" />
                        <MenuItem Header="Floating" Tag="Layers:Floating" Click="OnPanelPlace" />
                        <MenuItem Header="Hidden" Tag="Layers:Hidden" Click="OnPanelPlace" />
                    </MenuItem>
                    <MenuItem Header="History">
                        <MenuItem Header="Left" Tag="History:Left" Click="OnPanelPlace" />
                        <MenuItem Header="Right" Tag="History:Right" Click="OnPanelPlace" />
                        <MenuItem Header="Top" Tag="History:Top" Click="OnPanelPlace" />
                        <MenuItem Header="Bottom" Tag="History:Bottom" Click="OnPanelPlace" />
                        <MenuItem Header="Floating" Tag="History:Floating" Click="OnPanelPlace" />
                        <MenuItem Header="Hidden" Tag="History:Hidden" Click="OnPanelPlace" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Reset Layout" Click="OnResetLayout" />
                </MenuItem>
                <MenuItem x:Name="LayoutPresetsMenu" Header="_Layout">
                    <MenuItem Header="Save As…" Click="OnSaveLayoutPreset" />
                    <MenuItem Header="Rename Current…" Click="OnRenameLayoutPreset" />
                    <MenuItem Header="Delete Current…" Click="OnDeleteLayoutPreset" />
                    <Separator />
                    <!-- Preset entries are inserted here at runtime; see RebuildLayoutPresetsMenu. -->
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Image" Classes="topbar">
                <MenuItem Header="_Resize…" Click="OnResize" Icon="{app:Icon Resize}" />
                <MenuItem Header="_Canvas Size…" Click="OnCanvasSize" Icon="{app:Icon CanvasSize}" />
                <MenuItem Header="_Crop to Selection" Click="OnCropToSelection" Icon="{app:Icon Crop}" />
                <Separator />
                <MenuItem Header="Flip _Horizontal" Click="OnFlipH" Icon="{app:Icon FlipH}" />
                <MenuItem Header="Flip _Vertical" Click="OnFlipV" Icon="{app:Icon FlipV}" />
                <MenuItem Header="Rotate 90° C_W" Click="OnRotateCW" Icon="{app:Icon RotateCW}" />
                <MenuItem Header="Rotate 90° CC_W" Click="OnRotateCCW" Icon="{app:Icon RotateCCW}" />
                <Separator />
                <MenuItem Header="_Flatten Image" Click="OnFlatten" Icon="{app:Icon Flatten}" />
            </MenuItem>
            <MenuItem Header="Effe_cts" Classes="topbar">
                <MenuItem Header="_Invert Colors" Tag="invert" Click="OnEffect" Icon="{app:Icon EffectInvert}" />
                <MenuItem Header="_Black &amp; White" Tag="gray" Click="OnEffect" Icon="{app:Icon EffectGray}" />
                <MenuItem Header="_Sepia" Tag="sepia" Click="OnEffect" Icon="{app:Icon EffectSepia}" />
                <Separator />
                <MenuItem Header="Brightness / Contrast…" Tag="bc" Click="OnAdjust" Icon="{app:Icon Adjust}" />
                <MenuItem Header="Hue / Saturation…" Tag="hsl" Click="OnAdjust" Icon="{app:Icon HueSat}" />
                <MenuItem Header="_Levels…" Tag="levels" Click="OnAdjust" Icon="{app:Icon Levels}" />
                <MenuItem Header="Cur_ves…" Click="OnCurves" Icon="{app:Icon Curves}" />
                <MenuItem Header="_Auto Levels" Tag="autolevels" Click="OnEffect" Icon="{app:Icon AutoLevels}" />
                <Separator />
                <MenuItem Header="Gaussian _Blur…" Tag="blur" Click="OnAdjust" Icon="{app:Icon Blur}" />
                <MenuItem Header="Sharpe_n" Tag="sharpen" Click="OnEffect" Icon="{app:Icon Sharpen}" />
                <MenuItem Header="_Emboss" Tag="emboss" Click="OnEffect" Icon="{app:Icon Emboss}" />
                <MenuItem Header="Edge _Detect" Tag="edge" Click="OnEffect" Icon="{app:Icon EdgeDetect}" />
                <MenuItem Header="_Posterize…" Tag="posterize" Click="OnAdjust" Icon="{app:Icon Posterize}" />
                <MenuItem Header="Add _Noise…" Tag="noise" Click="OnAdjust" Icon="{app:Icon Noise}" />
            </MenuItem>
        </Menu>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="6,0" VerticalAlignment="Center">
            <StackPanel.Styles>
                <Style Selector="ToggleButton.paneltoggle">
                    <Setter Property="Width" Value="26" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="Margin" Value="1" />
                </Style>
            </StackPanel.Styles>
            <ToggleButton x:Name="ToggleTools" Classes="paneltoggle" Tag="Tools" Click="OnPanelToggle"
                          ToolTip.Tip="Show/hide the Tools panel" />
            <ToggleButton x:Name="ToggleColors" Classes="paneltoggle" Tag="Colors" Click="OnPanelToggle"
                          ToolTip.Tip="Show/hide the Colors panel" />
            <ToggleButton x:Name="ToggleColorWheel" Classes="paneltoggle" Tag="ColorWheel" Click="OnPanelToggle"
                          ToolTip.Tip="Show/hide the Color Wheel panel" />
            <ToggleButton x:Name="ToggleLayers" Classes="paneltoggle" Tag="Layers" Click="OnPanelToggle"
                          ToolTip.Tip="Show/hide the Layers panel" />
            <ToggleButton x:Name="ToggleHistory" Classes="paneltoggle" Tag="History" Click="OnPanelToggle"
                          ToolTip.Tip="Show/hide the History panel" />
        </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Background="#282828" Padding="8,5">
            <WrapPanel Orientation="Horizontal">
                <WrapPanel.Styles>
                    <Style Selector="StackPanel.group">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="Spacing" Value="4" />
                        <Setter Property="Margin" Value="0,2,12,2" />
                    </Style>
                    <Style Selector="StackPanel.group > TextBlock">
                        <Setter Property="Foreground" Value="#C0C0C0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </WrapPanel.Styles>
                <StackPanel Classes="group">
                    <TextBlock Text="Fg:" />
                    <Button Classes="swatch" Tag="#000000" Click="OnColor" Background="Black" Width="22" Height="22" />
                    <Button Classes="swatch" Tag="#FFFFFF" Click="OnColor" Background="White" Width="22" Height="22" />
                    <Button Classes="swatch" Tag="#E01010" Click="OnColor" Background="#E01010" Width="22" Height="22" />
                    <Button Classes="swatch" Tag="#20B020" Click="OnColor" Background="#20B020" Width="22" Height="22" />
                    <Button Classes="swatch" Tag="#2050E0" Click="OnColor" Background="#2050E0" Width="22" Height="22" />
                </StackPanel>
                <!-- Option groups are enabled/disabled per tool (see SelectTool) so the toolbar
                     only offers what the active tool actually uses. -->
                <StackPanel x:Name="SizeGroup" Classes="group">
                    <TextBlock Text="Size:" />
                    <ComboBox x:Name="SizeBox" Width="86" IsEditable="True" VerticalAlignment="Center"
                              ItemsSource="{x:Static app:MainView.BrushSizePresets}"
                              SelectionChanged="OnSizePresetSelected"
                              KeyDown="OnSizeKeyDown" LostFocus="OnSizeTextCommit"
                              ToolTip.Tip="Brush / outline thickness — pick a size or type your own; scroll to nudge it" />
                </StackPanel>
                <StackPanel x:Name="ShapeGroup" Classes="group">
                    <CheckBox x:Name="AntialiasCheck" Content="AA" IsChecked="True"
                              VerticalAlignment="Center" IsCheckedChanged="OnAntialias"
                              ToolTip.Tip="Antialias strokes and outlines" />
                    <CheckBox x:Name="FillShapesCheck" Content="Fill"
                              VerticalAlignment="Center" IsCheckedChanged="OnFillShapes"
                              ToolTip.Tip="Draw shapes filled instead of outlined" />
                </StackPanel>
                <StackPanel x:Name="BucketGroup" Classes="group">
                    <CheckBox x:Name="GlobalFillCheck" Content="Global"
                              VerticalAlignment="Center" IsCheckedChanged="OnGlobalFill"
                              ToolTip.Tip="Fill every matching pixel, not just the contiguous region" />
                    <TextBlock Text="Tol:" />
                    <ComboBox x:Name="ToleranceBox" Width="86" IsEditable="True" VerticalAlignment="Center"
                              ItemsSource="{x:Static app:MainView.TolerancePresets}"
                              SelectionChanged="OnTolerancePresetSelected"
                              KeyDown="OnToleranceKeyDown" LostFocus="OnToleranceTextCommit"
                              ToolTip.Tip="How far a pixel's color may differ and still be filled — pick a value or type your own; scroll to nudge it" />
                </StackPanel>
                <StackPanel x:Name="SelectGroup" Classes="group">
                    <TextBlock Text="Selection:" />
                    <ToggleButton x:Name="CombineReplaceBtn" Content="New" Tag="Replace" Click="OnSelectionCombineMode"
                                  IsChecked="True" ToolTip.Tip="Replace the current selection (S)" />
                    <ToggleButton x:Name="CombineAddBtn" Content="+" Tag="Add" Click="OnSelectionCombineMode"
                                  ToolTip.Tip="Add to the current selection" />
                    <ToggleButton x:Name="CombineSubtractBtn" Content="−" Tag="Subtract" Click="OnSelectionCombineMode"
                                  ToolTip.Tip="Subtract from the current selection" />
                    <ToggleButton x:Name="CombineIntersectBtn" Content="∩" Tag="Intersect" Click="OnSelectionCombineMode"
                                  ToolTip.Tip="Keep only the overlap with the current selection" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#202020" Padding="8,3">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="StatusText" Foreground="#C0C0C0" Text="Ready" />
                <TextBlock x:Name="CoordText" Grid.Column="1" Foreground="#C0C0C0" Text="" Margin="0,0,16,0" />
                <TextBlock x:Name="ZoomText" Grid.Column="2" Foreground="#C0C0C0" Text="Fit" />
            </Grid>
        </Border>

        <!-- Colors palette strip -->
        <Border x:Name="ColorsBorder" DockPanel.Dock="Bottom" Background="#282828" BorderBrush="#404040" BorderThickness="0,1,0,0" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ColorsTitle" Text="Colors" Foreground="#E0E0E0" FontWeight="Bold" VerticalAlignment="Center" />
                <WrapPanel x:Name="PaletteStrip" VerticalAlignment="Center" MaxWidth="640" />
                <Border Width="1" Background="#505050" Margin="4,2" />
                <Button Click="OnAddPaletteColor" ToolTip.Tip="Add current foreground color">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ContentControl Content="{app:Icon Plus}" />
                        <TextBlock Text="Add" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnSavePalette" ToolTip.Tip="Save palette to file">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ContentControl Content="{app:Icon Save}" />
                        <TextBlock Text="Save…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnLoadPalette" ToolTip.Tip="Load palette from file">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ContentControl Content="{app:Icon Open}" />
                        <TextBlock Text="Load…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="ColorsHeader" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ToggleButton x:Name="FloatColorsBtn" Padding="4,0" Tag="Colors" Click="OnPanelFloatToggle" />
                    <Button Content="{app:Icon Close}" Padding="6,0" Tag="Colors:Hidden" Click="OnPanelPlace"
                            ToolTip.Tip="Hide (View ▸ Panels to restore)" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Color Wheel panel -->
        <Border x:Name="ColorWheelBorder" DockPanel.Dock="Right" Width="190" Background="#262626" BorderBrush="#404040" BorderThickness="1,0,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8" Spacing="8">
                    <Grid x:Name="ColorWheelHeader" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="Color" Foreground="#E0E0E0" FontWeight="Bold" VerticalAlignment="Center" />
                        <ToggleButton x:Name="FloatColorWheelBtn" Grid.Column="1" Padding="4,0" Tag="ColorWheel" Click="OnPanelFloatToggle" />
                        <Button Grid.Column="2" Content="{app:Icon Close}" Padding="4,0" Tag="ColorWheel:Hidden" Click="OnPanelPlace"
                                ToolTip.Tip="Hide (View ▸ Panels to restore)" />
                    </Grid>

                    <!-- Active-target swatches: click to choose which color the wheel edits.
                         Border, not Button: the theme's button template repaints its content
                         background on hover, which would mask the swatch color. -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="4">
                        <Border x:Name="FgSwatch" Grid.Column="0" Height="30" MinWidth="40"
                                HorizontalAlignment="Stretch" Cursor="Hand"
                                BorderBrush="#8CB4FF" BorderThickness="2" CornerRadius="3"
                                PointerPressed="OnSelectFg" ToolTip.Tip="Foreground (click to edit)" />
                        <Button Grid.Column="1" Content="{app:Icon Swap}" Padding="8,0" Click="OnSwapColors"
                                VerticalAlignment="Stretch" ToolTip.Tip="Swap foreground / background" />
                        <Border x:Name="BgSwatch" Grid.Column="2" Height="30" MinWidth="40"
                                HorizontalAlignment="Stretch" Cursor="Hand"
                                BorderBrush="#505050" BorderThickness="2" CornerRadius="3"
                                PointerPressed="OnSelectBg" ToolTip.Tip="Background (click to edit)" />
                    </Grid>

                    <ColorSpectrum x:Name="ColorWheel" Shape="Ring" Components="HueSaturation"
                                   Height="150" MinWidth="0" MinHeight="0"
                                   HorizontalAlignment="Stretch"
                                   ColorChanged="OnSpectrumChanged" />

                    <TextBlock Text="Value" Foreground="#A0A0A0" FontSize="11" />
                    <ColorSlider x:Name="ValueSlider" ColorModel="Hsva" ColorComponent="Component3"
                                 IsAlphaVisible="False" Height="18" ColorChanged="OnValueSliderChanged" />

                    <TextBlock Text="Alpha" Foreground="#A0A0A0" FontSize="11" />
                    <ColorSlider x:Name="AlphaSlider" ColorModel="Hsva" ColorComponent="Alpha"
                                 Height="18" ColorChanged="OnAlphaSliderChanged" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <TextBlock Text="#" Foreground="#A0A0A0" VerticalAlignment="Center" />
                        <TextBox x:Name="HexBox" Grid.Column="1" FontFamily="monospace" Padding="4,2"
                                 KeyDown="OnHexKeyDown" LostFocus="OnHexCommit" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Layers panel -->
        <Border x:Name="LayersBorder" DockPanel.Dock="Right" Width="220" Background="#262626" BorderBrush="#404040" BorderThickness="1,0,0,0">
            <DockPanel Margin="6">
                <Grid x:Name="LayersHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="2,2,2,6">
                    <TextBlock Text="Layers" Foreground="#E0E0E0" FontWeight="Bold" VerticalAlignment="Center" />
                    <ToggleButton x:Name="FloatLayersBtn" Grid.Column="1" Padding="4,0" Tag="Layers" Click="OnPanelFloatToggle" />
                    <Button Grid.Column="2" Content="{app:Icon Close}" Padding="4,0" Tag="Layers:Hidden" Click="OnPanelPlace"
                            ToolTip.Tip="Hide (View ▸ Panels to restore)" />
                </Grid>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <WrapPanel.Styles>
                        <Style Selector="Button.layerbtn > StackPanel">
                            <Setter Property="Orientation" Value="Horizontal" />
                            <Setter Property="Spacing" Value="4" />
                        </Style>
                    </WrapPanel.Styles>
                    <Button Classes="layerbtn" Click="OnAddLayer" Margin="0,0,4,4" ToolTip.Tip="Add a new layer">
                        <StackPanel><ContentControl Content="{app:Icon Plus}" /><TextBlock Text="Add" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="layerbtn" Click="OnDuplicateLayer" Margin="0,0,4,4" ToolTip.Tip="Duplicate the active layer">
                        <StackPanel><ContentControl Content="{app:Icon Copy}" /><TextBlock Text="Dup" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="layerbtn" Click="OnDeleteLayer" Margin="0,0,4,4" ToolTip.Tip="Delete the active layer">
                        <StackPanel><ContentControl Content="{app:Icon Trash}" /><TextBlock Text="Del" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="layerbtn" Click="OnMergeDown" Margin="0,0,4,4" ToolTip.Tip="Merge into the layer below">
                        <StackPanel><ContentControl Content="{app:Icon MergeDown}" /><TextBlock Text="Merge" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="layerbtn" Click="OnImportLayer" Margin="0,0,4,4" ToolTip.Tip="Import an image file as a new layer">
                        <StackPanel><ContentControl Content="{app:Icon Open}" /><TextBlock Text="Import" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Content="{app:Icon ChevronUp}" Click="OnLayerUp" Margin="0,0,4,4" ToolTip.Tip="Move layer up" />
                    <Button Content="{app:Icon ChevronDown}" Click="OnLayerDown" Margin="0,0,4,4" ToolTip.Tip="Move layer down" />
                </WrapPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="Blend mode" Foreground="#A0A0A0" Margin="2,0" />
                    <ComboBox x:Name="BlendCombo" HorizontalAlignment="Stretch"
                              SelectionChanged="OnBlendChanged" />
                    <TextBlock Text="Opacity" Foreground="#A0A0A0" Margin="2,6,2,0" />
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="255" Value="255"
                            ValueChanged="OnOpacityChanged" />
                </StackPanel>
                <ListBox x:Name="LayerList" Background="#1E1E1E"
                         SelectionChanged="OnLayerSelected" />
            </DockPanel>
        </Border>

        <!-- History panel -->
        <Border x:Name="HistoryBorder" DockPanel.Dock="Right" Width="220" Background="#262626" BorderBrush="#404040" BorderThickness="1,0,0,0">
            <DockPanel Margin="6">
                <Grid x:Name="HistoryHeader" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="2,2,2,6">
                    <TextBlock Text="History" Foreground="#E0E0E0" FontWeight="Bold" VerticalAlignment="Center" />
                    <ToggleButton x:Name="FloatHistoryBtn" Grid.Column="1" Padding="4,0" Tag="History" Click="OnPanelFloatToggle" />
                    <Button Grid.Column="2" Content="{app:Icon Close}" Padding="4,0" Tag="History:Hidden" Click="OnPanelPlace"
                            ToolTip.Tip="Hide (View ▸ Panels to restore)" />
                </Grid>
                <TextBlock x:Name="HistoryUsageText" DockPanel.Dock="Bottom" Foreground="#808080" FontSize="11"
                           Margin="2,6,2,2" Text="0 steps" />
                <Button x:Name="ClearHistoryBtn" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                        Click="OnClearHistory" ToolTip.Tip="Discard the entire undo history">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <ContentControl Content="{app:Icon Trash}" />
                        <TextBlock Text="Clear History" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ListBox x:Name="HistoryList" Background="#1E1E1E" SelectionChanged="OnHistorySelected" />
            </DockPanel>
        </Border>

        <Border x:Name="ToolsBorder" DockPanel.Dock="Left" Width="70" Background="#262626"
                BorderBrush="#404040" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel x:Name="ToolsHeader" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="2">
                    <ToggleButton x:Name="FloatToolsBtn" Padding="4,0" Tag="Tools" Click="OnPanelFloatToggle" />
                    <Button Content="{app:Icon Close}" Padding="4,0" Tag="Tools:Hidden" Click="OnPanelPlace"
                            ToolTip.Tip="Hide (View ▸ Panels to restore)" />
                </StackPanel>
                <WrapPanel x:Name="ToolPalette" Orientation="Horizontal" Margin="4" />
            </DockPanel>
        </Border>

        <app:SurfaceView x:Name="Canvas" />
    </DockPanel>
    <Panel x:Name="FloatingLayer" />
    </Panel>
</UserControl>
